# Higgsfield API credentials — get these from your Higgsfield account settings.
# Copy this file to .env and fill in the values. .env is gitignored.
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=

# Public URL of the deployed Somatic Pause app.
SOMATIC_PAUSE_URL=https://somatic-pause-app.vercel.app/

# Login for the Somatic Pause app. The check-in screen the assets need is behind
# auth, so capture.mjs signs in headlessly. These are read from env only — never
# logged, never printed, never committed.
SOMATIC_PAUSE_EMAIL=
SOMATIC_PAUSE_PASSWORD=
